{
  "version": 8,
  "name": "Приоритет Паркет — салоны",
  "sources": {
    "osm": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "paper", "type": "background",
      "paint": { "background-color": "#ffffff" }
    },
    {
      "id": "green-areas", "type": "fill", "source": "osm", "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "grass"], true, false],
      "paint": { "fill-color": "#f5f6f3" }
    },
    {
      "id": "water", "type": "fill", "source": "osm", "source-layer": "water",
      "paint": { "fill-color": "#e3e8e8" }
    },
    {
      "id": "waterways", "type": "line", "source": "osm", "source-layer": "waterway", "minzoom": 10,
      "paint": { "line-color": "#cdd7d7", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 0.7, 17, 2.2] }
    },
    {
      "id": "country-borders", "type": "line", "source": "osm", "source-layer": "boundary", "maxzoom": 11,
      "filter": ["==", ["get", "admin_level"], 2],
      "paint": { "line-color": "#b3a69e", "line-width": 1, "line-dasharray": [3, 3] }
    },
    {
      "id": "buildings", "type": "fill", "source": "osm", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#eeeae7", "fill-outline-color": "#dfd9d4" }
    },
    {
      "id": "rail", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 12,
      "filter": ["match", ["get", "class"], ["rail", "transit"], true, false],
      "paint": { "line-color": "#aa9e95", "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.7, 17, 1.5], "line-dasharray": [3, 2] }
    },
    {
      "id": "walking-paths", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 15,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["path", "track"], true, false]],
      "paint": { "line-color": "#947c6c", "line-width": 1, "line-dasharray": [2, 2] }
    },
    {
      "id": "side-streets", "type": "line", "source": "osm", "source-layer": "transportation", "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["minor", "service"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#765540", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.65, 13, 1.05, 15, 1.6, 19, 3.2] }
    },
    {
      "id": "through-streets", "type": "line", "source": "osm", "source-layer": "transportation",
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["secondary", "tertiary"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#634532", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.6, 12, 1.35, 15, 2.3, 19, 4.6] }
    },
    {
      "id": "arteries", "type": "line", "source": "osm", "source-layer": "transportation",
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["primary", "trunk", "motorway"], true, false]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#503521", "line-width": ["interpolate", ["linear"], ["zoom"], 4, 0.45, 9, 1, 12, 1.85, 15, 3.2, 19, 5.5] }
    },
    {
      "id": "house-numbers", "type": "symbol", "source": "osm", "source-layer": "housenumber", "minzoom": 17,
      "layout": { "text-field": ["to-string", ["get", "housenumber"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-padding": 4 },
      "paint": { "text-color": "#5a463b", "text-halo-color": "#ffffff", "text-halo-width": 1 }
    },
    {
      "id": "road-labels", "type": "symbol", "source": "osm", "source-layer": "transportation_name", "minzoom": 12,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["motorway", "trunk", "primary", "secondary", "tertiary", "minor", "service"], true, false]],
      "layout": {
        "symbol-placement": "line", "symbol-spacing": 280,
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"], ["get", "ref"], ""],
        "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 12, 12, 16, 14],
        "text-padding": 3, "text-offset": [0, -0.7]
      },
      "paint": { "text-color": "#453023", "text-halo-color": "#ffffff", "text-halo-width": 1.6 }
    },
    {
      "id": "neighbourhood-labels", "type": "symbol", "source": "osm", "source-layer": "place", "minzoom": 10,
      "filter": ["match", ["get", "class"], ["suburb", "neighbourhood", "quarter", "village", "hamlet"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"], ""], "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 10, 12, 15, 15], "text-padding": 5
      },
      "paint": { "text-color": "#554031", "text-halo-color": "#ffffff", "text-halo-width": 1.7 }
    },
    {
      "id": "cities", "type": "symbol", "source": "osm", "source-layer": "place", "minzoom": 5, "maxzoom": 15,
      "filter": ["match", ["get", "class"], ["city", "town"], true, false],
      "layout": {
        "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"], ""], "text-font": ["Noto Sans Bold"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 5, 12, 10, 16, 14, 18], "text-padding": 6
      },
      "paint": { "text-color": "#35271f", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },
    {
      "id": "countries", "type": "symbol", "source": "osm", "source-layer": "place", "maxzoom": 7,
      "filter": ["==", ["get", "class"], "country"],
      "layout": { "text-field": ["coalesce", ["get", "name:ru"], ["get", "name"], ""], "text-font": ["Noto Sans Bold"], "text-size": 14, "text-padding": 6 },
      "paint": { "text-color": "#473b32", "text-halo-color": "#ffffff", "text-halo-width": 1.6 }
    }
  ]
}
